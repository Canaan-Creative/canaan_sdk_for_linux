From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] gpio: k230: add the per-pin driver definitions

Add the port property and platform data structures of the per-pin K230
GPIO driver, one gpio port of one line per device tree node.

Upstream-Status: Pending
---
 drivers/gpio/gpio-k230.h | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 drivers/gpio/gpio-k230.h

diff --git a/drivers/gpio/gpio-k230.h b/drivers/gpio/gpio-k230.h
new file mode 100644
index 000000000..c9ccaecee
--- /dev/null
+++ b/drivers/gpio/gpio-k230.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) 2026, Canaan Creative Co., Ltd.
+ */
+#ifndef GPIO_K230_H
+#define GPIO_K230_H
+
+#define K230_MAX_GPIOS		1
+#define K230_GPIOA_BASE_ADDR	(0x9140B000)
+#define K230_GPIOB_BASE_ADDR	(0x9140C000)
+
+struct k230_port_property {
+	struct fwnode_handle	*fwnode;
+	unsigned int		idx;
+	unsigned int		id;
+	unsigned int		ngpio;
+	unsigned int		gpio_base;
+	int			irq[K230_MAX_GPIOS];
+	bool			irq_shared;
+};
+
+struct k230_platform_data {
+	struct k230_port_property	*properties;
+	unsigned int			nports;
+};
+
+#endif
-- 
