-static int k230_gpio_request(struct gpio_chip *gc, unsigned int offset)
+static int k230_gpio_get(struct gpio_chip *gc, unsigned int gpio)
 {
+	gpio = gc->base;
+	if (gpio >= 32)
+		gpio = gpio % 32;
+
+	return !!(gc->read_reg(gc->reg_dat) & BIT(gpio));
