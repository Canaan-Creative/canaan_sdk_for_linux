From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] reset: k230: map the restart register at probe

The restart handler mapped the CPU0 reset control register with
ioremap() each time it ran. A panic in interrupt context, such as a
soft lockup detected from the watchdog hrtimer, runs the restart
handler in that context, where ioremap() hits BUG_ON(in_interrupt())
in the vmalloc code, so the board never reboots. Map the register
once when the handler is registered and do not register the handler
if the mapping fails.

Upstream-Status: Pending
---
 drivers/reset/reset-k230.c | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/drivers/reset/reset-k230.c b/drivers/reset/reset-k230.c
index 41c8e89..7e84f13 100644
--- a/drivers/reset/reset-k230.c
+++ b/drivers/reset/reset-k230.c
@@ -308,16 +308,13 @@ static const struct reset_control_ops k230_reset_ops = {
 	.assert = k230_reset_assert,
 	.deassert = k230_reset_deassert,
 };
+
+static void __iomem *k230_cpu0_rst_ctl;
+
 static int k230_restart(struct notifier_block *this, unsigned long mode,
 			void *cmd)
 {
-#define SYSCTL_BOOT_BASE_ADDR 0x91102000U
-#define CPU0_RST_CTL 0x60
-
-	void __iomem *MMAP_ADDR =
-		ioremap(SYSCTL_BOOT_BASE_ADDR + CPU0_RST_CTL, 4);
-
-	writel(((1 << 0) | (1 << 16)), MMAP_ADDR);
+	writel(((1 << 0) | (1 << 16)), k230_cpu0_rst_ctl);
 
 	while (1)
 		;
@@ -327,8 +324,15 @@ static int k230_restart(struct notifier_block *this, unsigned long mode,
 
 static int k230_restart_register(void)
 {
+#define SYSCTL_BOOT_BASE_ADDR 0x91102000U
+#define CPU0_RST_CTL 0x60
+
 	static struct notifier_block restart_handler;
 
+	k230_cpu0_rst_ctl = ioremap(SYSCTL_BOOT_BASE_ADDR + CPU0_RST_CTL, 4);
+	if (!k230_cpu0_rst_ctl)
+		return -ENOMEM;
+
 	restart_handler.notifier_call = k230_restart;
 	restart_handler.priority = 128;
 
