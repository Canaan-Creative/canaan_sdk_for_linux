From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] serial: 8250: support tx-only dma through the dw shadow thr

Let an 8250 port use DMA for transmit only:

 - The 8250 DMA core treats the receive channel as optional. Without
   one, the port receives by PIO and interrupt, and set_termios
   selects FIFO DMA mode with a half-full transmit trigger and the
   DesignWare programmable THRE interrupt (PTIME).
 - 8250_dw points the transmit DMA at the shadow THR (base + 0x30)
   with a 16-byte burst when the node has the boolean property
   "canaan,uart-tx-dma-sthr".

Upstream-Status: Pending
---
 drivers/tty/serial/8250/8250_dma.c  | 65 ++++++++++++++++-------------
 drivers/tty/serial/8250/8250_dw.c   |  5 +++
 drivers/tty/serial/8250/8250_port.c | 12 ++++++
 3 files changed, 53 insertions(+), 29 deletions(-)

diff --git a/drivers/tty/serial/8250/8250_dma.c b/drivers/tty/serial/8250/8250_dma.c
index 7fa665017..71ad17f18 100644
--- a/drivers/tty/serial/8250/8250_dma.c
+++ b/drivers/tty/serial/8250/8250_dma.c
@@ -205,21 +205,20 @@ int serial8250_request_dma(struct uart_8250_port *p)
 	dma->rxchan = dma_request_slave_channel_compat(mask,
 						       dma->fn, dma->rx_param,
 						       p->port.dev, "rx");
-	if (!dma->rxchan)
-		return -ENODEV;
+	if (dma->rxchan) {
+		/* 8250 rx dma requires dmaengine driver to support pause/terminate */
+		ret = dma_get_slave_caps(dma->rxchan, &caps);
+		if (ret)
+			goto release_rx;
+		if (!caps.cmd_pause || !caps.cmd_terminate ||
+		    caps.residue_granularity == DMA_RESIDUE_GRANULARITY_DESCRIPTOR) {
+			ret = -EINVAL;
+			goto release_rx;
+		}
 
-	/* 8250 rx dma requires dmaengine driver to support pause/terminate */
-	ret = dma_get_slave_caps(dma->rxchan, &caps);
-	if (ret)
-		goto release_rx;
-	if (!caps.cmd_pause || !caps.cmd_terminate ||
-	    caps.residue_granularity == DMA_RESIDUE_GRANULARITY_DESCRIPTOR) {
-		ret = -EINVAL;
-		goto release_rx;
+		dmaengine_slave_config(dma->rxchan, &dma->rxconf);
 	}
 
-	dmaengine_slave_config(dma->rxchan, &dma->rxconf);
-
 	/* Get a channel for TX */
 	dma->txchan = dma_request_slave_channel_compat(mask,
 						       dma->fn, dma->tx_param,
@@ -241,14 +240,17 @@ int serial8250_request_dma(struct uart_8250_port *p)
 	dmaengine_slave_config(dma->txchan, &dma->txconf);
 
 	/* RX buffer */
-	if (!dma->rx_size)
-		dma->rx_size = PAGE_SIZE;
-
-	dma->rx_buf = dma_alloc_coherent(dma->rxchan->device->dev, dma->rx_size,
-					&dma->rx_addr, GFP_KERNEL);
-	if (!dma->rx_buf) {
-		ret = -ENOMEM;
-		goto err;
+	if (dma->rxchan) {
+		if (!dma->rx_size)
+			dma->rx_size = PAGE_SIZE;
+
+		dma->rx_buf = dma_alloc_coherent(dma->rxchan->device->dev,
+						 dma->rx_size, &dma->rx_addr,
+						 GFP_KERNEL);
+		if (!dma->rx_buf) {
+			ret = -ENOMEM;
+			goto err;
+		}
 	}
 
 	/* TX buffer */
@@ -257,19 +259,22 @@ int serial8250_request_dma(struct uart_8250_port *p)
 					UART_XMIT_SIZE,
 					DMA_TO_DEVICE);
 	if (dma_mapping_error(dma->txchan->device->dev, dma->tx_addr)) {
-		dma_free_coherent(dma->rxchan->device->dev, dma->rx_size,
-				  dma->rx_buf, dma->rx_addr);
+		if (dma->rxchan)
+			dma_free_coherent(dma->rxchan->device->dev, dma->rx_size,
+					  dma->rx_buf, dma->rx_addr);
 		ret = -ENOMEM;
 		goto err;
 	}
 
-	dev_dbg_ratelimited(p->port.dev, "got both dma channels\n");
+	dev_dbg_ratelimited(p->port.dev, "got %s dma channel(s)\n",
+			    dma->rxchan ? "both" : "tx");
 
 	return 0;
 err:
 	dma_release_channel(dma->txchan);
 release_rx:
-	dma_release_channel(dma->rxchan);
+	if (dma->rxchan)
+		dma_release_channel(dma->rxchan);
 	return ret;
 }
 EXPORT_SYMBOL_GPL(serial8250_request_dma);
@@ -282,11 +287,13 @@ void serial8250_release_dma(struct uart_8250_port *p)
 		return;
 
 	/* Release RX resources */
-	dmaengine_terminate_sync(dma->rxchan);
-	dma_free_coherent(dma->rxchan->device->dev, dma->rx_size, dma->rx_buf,
-			  dma->rx_addr);
-	dma_release_channel(dma->rxchan);
-	dma->rxchan = NULL;
+	if (dma->rxchan) {
+		dmaengine_terminate_sync(dma->rxchan);
+		dma_free_coherent(dma->rxchan->device->dev, dma->rx_size,
+				  dma->rx_buf, dma->rx_addr);
+		dma_release_channel(dma->rxchan);
+		dma->rxchan = NULL;
+	}
 
 	/* Release TX resources */
 	dmaengine_terminate_sync(dma->txchan);
diff --git a/drivers/tty/serial/8250/8250_dw.c b/drivers/tty/serial/8250/8250_dw.c
index 8aed33be2..ec01241c1 100644
--- a/drivers/tty/serial/8250/8250_dw.c
+++ b/drivers/tty/serial/8250/8250_dw.c
@@ -673,6 +673,11 @@ static int dw8250_probe(struct platform_device *pdev)
 		data->data.dma.rxconf.src_maxburst = p->fifosize / 4;
 		data->data.dma.txconf.dst_maxburst = p->fifosize / 4;
 		up->dma = &data->data.dma;
+
+		if (device_property_read_bool(dev, "canaan,uart-tx-dma-sthr")) {
+			data->data.dma.tx_dma_addr = p->mapbase + 0x30;
+			data->data.dma.txconf.dst_maxburst = 16;
+		}
 	}
 
 	data->data.line = serial8250_register_8250_port(up);
diff --git a/drivers/tty/serial/8250/8250_port.c b/drivers/tty/serial/8250/8250_port.c
index a17803da8..2aacd951d 100644
--- a/drivers/tty/serial/8250/8250_port.c
+++ b/drivers/tty/serial/8250/8250_port.c
@@ -1872,8 +1872,15 @@ unsigned int serial8250_modem_status(struct uart_8250_port *up)
 }
 EXPORT_SYMBOL_GPL(serial8250_modem_status);
 
+#ifndef UART_IER_PTIME
+#define UART_IER_PTIME	0x80
+#endif
+
 static bool handle_rx_dma(struct uart_8250_port *up, unsigned int iir)
 {
+	if (!up->dma->rxchan)
+		return true;
+
 	switch (iir & 0x3f) {
 	case UART_IIR_THRI:
 		/*
@@ -2859,6 +2866,11 @@ serial8250_do_set_termios(struct uart_port *port, struct ktermios *termios,
 	if (up->capabilities & UART_CAP_RTOIE)
 		up->ier |= UART_IER_RTOIE;
 
+	if (up->dma && up->dma->txchan && !up->dma->rxchan) {
+		up->ier |= UART_IER_PTIME;
+		up->fcr |= UART_FCR_DMA_SELECT | UART_FCR_T_TRIG_11;
+	}
+
 	serial_port_out(port, UART_IER, up->ier);
 
 	if (up->capabilities & UART_CAP_EFR) {
-- 
2.43.0

