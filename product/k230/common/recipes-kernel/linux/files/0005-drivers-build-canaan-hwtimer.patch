From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] drivers: build the canaan hwtimer driver

Source drivers/canaan-hwtimer/Kconfig and descend into
drivers/canaan-hwtimer/ when CANAAN_HWTIMER is set.

Upstream-Status: Pending
---
 drivers/Kconfig  | 2 ++
 drivers/Makefile | 1 +
 2 files changed, 3 insertions(+)

diff --git a/drivers/Kconfig b/drivers/Kconfig
index efb66e25f..55127edf7 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -243,4 +243,6 @@ source "drivers/hte/Kconfig"
 
 source "drivers/cdx/Kconfig"
 
+source "drivers/canaan-hwtimer/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 1bec7819a..01039a1b2 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -197,5 +197,6 @@ obj-$(CONFIG_PECI)		+= peci/
 obj-$(CONFIG_HTE)		+= hte/
 obj-$(CONFIG_DRM_ACCEL)		+= accel/
 obj-$(CONFIG_CDX_BUS)		+= cdx/
+obj-$(CONFIG_CANAAN_HWTIMER)	+= canaan-hwtimer/
 
 obj-$(CONFIG_S390)		+= s390/
-- 
2.43.0

