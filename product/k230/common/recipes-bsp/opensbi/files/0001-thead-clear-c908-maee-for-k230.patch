From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] platform: generic: thead: clear T-Head C908 MAEE bit for K230 in generic platform path

OpenSBI 1.7 builds with PLATFORM=generic for K230.

This hooks into the existing generic THEAD plugin chain so the fix
fires when the DTB is identified as canaan,k230:

  - c9xx_errata.h: define THEAD_QUIRK_DISABLE_MAEE
  - thead-generic.c: add thead_maee_early_init that clears
    MXSTATUS.MAEE (bit 21) on cold boot, then chains to
    generic_early_init.  Wire it into the quirk dispatch and add
    the K230 DTB compatible to the match table.

MAEE=1 selects T-Head's extended PTE encoding, which
overlaps the standard Svpbmt bits Linux 6.6 expects.  With MAEE set,
normal kernel pages are interpreted as non-cacheable / device, and
the first S-mode amoadd / amoor / amocas (e.g. atomic_inc, set_bit,
cmpxchg) hangs waiting for coherence.  The bit is therefore cleared
before the hart drops to S-mode.

Upstream-Status: Pending
---
 platform/generic/include/thead/c9xx_errata.h |  1 +
 platform/generic/thead/thead-generic.c       | 17 +++++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/platform/generic/include/thead/c9xx_errata.h b/platform/generic/include/thead/c9xx_errata.h
index 40c1587b..0336aeba 100644
--- a/platform/generic/include/thead/c9xx_errata.h
+++ b/platform/generic/include/thead/c9xx_errata.h
@@ -8,6 +8,7 @@
  */
 #define THEAD_QUIRK_ERRATA_TLB_FLUSH		BIT(0)
 #define THEAD_QUIRK_ERRATA_THEAD_PMU		BIT(1)
+#define THEAD_QUIRK_DISABLE_MAEE		BIT(2)
 
 void thead_register_tlb_flush_trap_handler(void);
 
diff --git a/platform/generic/thead/thead-generic.c b/platform/generic/thead/thead-generic.c
index ddb4f0bf..97f219c5 100644
--- a/platform/generic/thead/thead-generic.c
+++ b/platform/generic/thead/thead-generic.c
@@ -14,6 +14,8 @@
 #include <sbi/sbi_scratch.h>
 #include <sbi/sbi_string.h>
 #include <sbi_utils/fdt/fdt_helper.h>
+#include <thead/c9xx_encoding.h>
+#include <sbi/riscv_asm.h>
 
 struct thead_generic_quirks {
 	u64	errata;
@@ -39,6 +41,14 @@ static int thead_pmu_extensions_init(struct sbi_hart_features *hfeatures)
 	return 0;
 }
 
+static int thead_maee_early_init(bool cold_boot)
+{
+	if (cold_boot)
+		csr_clear(THEAD_C9XX_CSR_MXSTATUS, 1UL << 21);
+
+	return generic_early_init(cold_boot);
+}
+
 static int thead_generic_platform_init(const void *fdt, int nodeoff,
 				       const struct fdt_match *match)
 {
@@ -48,6 +58,8 @@ static int thead_generic_platform_init(const void *fdt, int nodeoff,
 		generic_platform_ops.early_init = thead_tlb_flush_early_init;
 	if (quirks->errata & THEAD_QUIRK_ERRATA_THEAD_PMU)
 		generic_platform_ops.extensions_init = thead_pmu_extensions_init;
+	if (quirks->errata & THEAD_QUIRK_DISABLE_MAEE)
+		generic_platform_ops.early_init = thead_maee_early_init;
 
 	return 0;
 }
@@ -60,7 +72,12 @@ static const struct thead_generic_quirks thead_pmu_quirks = {
 	.errata = THEAD_QUIRK_ERRATA_THEAD_PMU,
 };
 
+static const struct thead_generic_quirks thead_k230_quirks = {
+	.errata = THEAD_QUIRK_ERRATA_THEAD_PMU | THEAD_QUIRK_DISABLE_MAEE,
+};
+
 static const struct fdt_match thead_generic_match[] = {
+	{ .compatible = "canaan,k230", .data = &thead_k230_quirks },
 	{ .compatible = "canaan,kendryte-k230", .data = &thead_pmu_quirks },
 	{ .compatible = "sophgo,cv1800b", .data = &thead_pmu_quirks },
 	{ .compatible = "sophgo,cv1812h", .data = &thead_pmu_quirks },
-- 
2.43.0

