+	/* 24-bit data resolution of the receiver */
+	RESOLUTION_24_BIT = 0x4,
+	/* 32-bit data resolution of the receiver */
+	RESOLUTION_32_BIT = 0x5
+} i2s_word_length_t;
+
+typedef enum _word_select_cycles {
+	/* 16 sclk cycles */
+	SCLK_CYCLES_16 = 0x0,
+	/* 24 sclk cycles */
+	SCLK_CYCLES_24 = 0x1,
+	/* 32 sclk cycles */
+	SCLK_CYCLES_32 = 0x2
+} i2s_word_select_cycles_t;
+
+typedef enum _sclk_gating_cycles {
+	/* Clock gating is diable */
+	NO_CLOCK_GATING = 0x0,
+	/* Gating after 12 sclk cycles */
+	CLOCK_CYCLES_12 = 0x1,
+	/* Gating after 16 sclk cycles */
+	CLOCK_CYCLES_16 = 0x2,
+	/* Gating after 20 sclk cycles */
+	CLOCK_CYCLES_20 = 0x3,
+	/* Gating after 24 sclk cycles */
+	CLOCK_CYCLES_24 = 0x4
+} i2s_sclk_gating_cycles_t;
+
+typedef enum _i2s_transmit {
+	I2S_TRANSMITTER = 0,
+	I2S_RECEIVER = 1
+} i2s_transmit_t;
+
+typedef enum {
+	AUDIO_OUT_TYPE_32BIT = 0,
+	AUDIO_OUT_TYPE_24BIT = 1,
+	AUDIO_OUT_TYPE_16BIT = 2,
+} audio_out_data_width_e;
+
+typedef enum {
+	AUDIO_OUT_MODE_TDM = 0,
+	AUDIO_OUT_MODE_PDM = 1,
+	AUDIO_OUT_MODE_I2S = 2,
+} audio_out_mode_e;
+
+void ws2812_init_led(void);
+#endif
diff --git a/board/canaan/k230_nano3s/st7789v.c b/board/canaan/k230_nano3s/st7789v.c
new file mode 100644
index 00000000..714b4df4
--- /dev/null
+++ b/board/canaan/k230_nano3s/st7789v.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (c) 2026, Canaan Creative Co., Ltd.
+ */
+#include "st7789v.h"
+#include "avalon_logo.h"
+
+#define QSPI1_BASE (0x91583000UL)
+
+volatile dw_spi_reg_t *spi_addr = (dw_spi_reg_t *)QSPI1_BASE;
+
+#define GPIO0_BASE_ADDR	(0x9140B000UL)
+#define GPIO1_BASE_ADDR	(0x9140C000UL)
+static char *kd_gpio[2] = { GPIO0_BASE_ADDR, GPIO1_BASE_ADDR };
+
+#define DATA_OUTPUT		0x0
+#define DIRECTION		0x04
+#define DATA_OUTPUT_STRIDE	0x0c	/* register stride 3*32 bits */
+#define DIRECTION_STRIDE	0x0c	/* register stride 3*32 bits */
+
+#define DC_PIN		41
+#define RESET_PIN	44
+#define MHz		(1000000)
+#define QSPI_CLOCK	(200 * MHz)
+#define SPI_BAUDR	(25 * MHz)
+#define WIDTH		240
+#define HEIGHT		240
+extern const unsigned char gImage_avalon_logo[];
+
+#define FBTFT_OF_INIT_CMD	BIT(24)
+#define FBTFT_OF_INIT_DELAY	BIT(25)
+
+static unsigned int init[] = {
+	0x10000FE, 0x10000EF, 0x10000EB, 0x14,
+	0x1000084, 0x40, 0x1000085, 0xFF, 0x1000086, 0xFF, 0x1000087, 0xFF,
+	0x1000088, 0x0A, 0x1000089, 0x21, 0x100008A, 0x00, 0x100008B, 0x80,
+	0x100008C, 0x01, 0x100008D, 0x01, 0x100008E, 0xFF, 0x100008F, 0xFF,
+	0x10000B6, 0x00, 0x20,
+	0x1000036, 0x08,
+	0x100003A, 0x05,
+	0x1000090, 0x08, 0x08, 0x08, 0x08,
+	0x10000BD, 0x06,
+	0x10000BC, 0x00,
+	0x10000FF, 0x60, 0x01, 0x04,
+	0x10000C3, 0x13,
+	0x10000C4, 0x13,
+	0x10000C9, 0x22,
+	0x10000BE, 0x11,
+	0x10000E1, 0x10, 0x0E,
+	0x10000DF, 0x21, 0x0C, 0x02,
+	0x10000F0, 0x45, 0x09, 0x08, 0x08, 0x26, 0x2A,
+	0x10000F1, 0x43, 0x70, 0x72, 0x36, 0x37, 0x6F,
+	0x10000F2, 0x45, 0x09, 0x08, 0x08, 0x26, 0x2A,
+	0x10000F3, 0x43, 0x70, 0x72, 0x36, 0x37, 0x6F,
+	0x10000ED, 0x1B, 0x0B,
+	0x10000AE, 0x77,
+	0x10000CD, 0x63,
+	0x1000070, 0x07, 0x07, 0x04, 0x0E, 0x0F, 0x09, 0x07, 0x08, 0x03,
+	0x10000E8, 0x34,
+	0x1000062, 0x18, 0x0D, 0x71, 0xED, 0x70, 0x70, 0x18, 0x0F, 0x71, 0xEF, 0x70, 0x70,
+	0x1000063, 0x18, 0x11, 0x71, 0xF1, 0x70, 0x70, 0x18, 0x13, 0x71, 0xF3, 0x70, 0x70,
+	0x1000064, 0x28, 0x29, 0xF1, 0x01, 0xF1, 0x00, 0x07,
+	0x1000066, 0x3C, 0x00, 0xCD, 0x67, 0x45, 0x45, 0x10, 0x00, 0x00, 0x00,
+	0x1000067, 0x00, 0x3C, 0x00, 0x00, 0x00, 0x01, 0x54, 0x10, 0x32, 0x98,
+	0x1000074, 0x10, 0x85, 0x80, 0x00, 0x00, 0x4E, 0x00,
+	0x1000098, 0x3e, 0x07,
+	0x1000035, 0x1000021, 0x1000011, 0x2000064, 0x1000029, 0x200000A,
+};
+
+static void kd_gpio_reg_writel(volatile char *reg, int offset,
+			       unsigned int value)
+{
+	unsigned int val = readl(reg);
+
+	val &= ~(1 << offset);
+	val |= (value << offset);
+	writel(val, reg);
+}
+
+static void gpio_pin_set_output(int pin, gpio_drive_mode_t mode)
+{
+	unsigned int dir;
+
+	switch (mode) {
+	case GPIO_DM_INPUT:
+		dir = 0;
+		break;
+	case GPIO_DM_OUTPUT:
+		dir = 1;
+		break;
+	default:
+		printf("GPIO drive mode is not supported.");
+		break;
+	}
+
+	if (pin < 32) {
+		kd_gpio_reg_writel(kd_gpio[0] + DIRECTION, pin, dir);
+	} else {
+		pin -= 32;
+		if (pin < 32) {
+			kd_gpio_reg_writel(kd_gpio[1] + DIRECTION, pin, dir);
+		} else {
+			pin -= 32;
+			kd_gpio_reg_writel(kd_gpio[1] + DIRECTION +
+						   DIRECTION_STRIDE,
+					   pin, dir);
+		}
+	}
+}
+
+void gpio_pin_set_value(int pin, int value)
+{
+	if (pin < 32) {
+		kd_gpio_reg_writel(kd_gpio[0] + DATA_OUTPUT, pin, value);
+	} else {
+		pin -= 32;
+		if (pin < 32) {
+			kd_gpio_reg_writel(kd_gpio[1] + DATA_OUTPUT, pin,
+					   value);
+		} else {
+			pin -= 32;
+			kd_gpio_reg_writel(kd_gpio[1] + DATA_OUTPUT +
+						   DATA_OUTPUT_STRIDE,
+					   pin, value);
+		}
+	}
+}
+
+static int tft_spi_init(void)
+{
+	unsigned int default_clk = QSPI_CLOCK;
+	unsigned int div = default_clk / SPI_BAUDR;
+
+	if (div & 1)
+		div++;
+
+	spi_addr->baudr = div;
+
+	spi_addr->rx_sample_delay = 5;
+
+	spi_addr->imr = 0;
+	spi_addr->ser = 0x00;
+	spi_addr->ssienr = 0x00;
+	spi_addr->ctrlr0 = (SPI_FORMAT_CPOL1_CPHA1 << 8) |
+			   (SPI_FF_STANDARD << 22) | ((8 - 1) << 0);
+
+	spi_addr->txftlr = 0;
+	spi_addr->rxftlr = 128;
+	return 0;
+}
+
+void lcd_write_cmd(char val)
+{
+	gpio_pin_set_value(DC_PIN, 0);
+
+	spi_addr->ctrlr0 |= DW_SPI_TMOD_BIT10;
+	spi_addr->ctrlr0 &= (~DW_SPI_TMOD_BIT11);
+
+	spi_addr->ssienr = 0x01;
+
+	spi_addr->dr[0] = val;
+	spi_addr->ser = 1;
+	while (((spi_addr->sr) & 0x05) != 0x04)
+		;
+
+	spi_addr->ser = 0x00;
+	spi_addr->ssienr = 0x00;
+}
+
+void lcd_write_data(char val)
+{
+	gpio_pin_set_value(DC_PIN, 1);
+
+	spi_addr->ctrlr0 |= DW_SPI_TMOD_BIT10;
+	spi_addr->ctrlr0 &= (~DW_SPI_TMOD_BIT11);
+
+	spi_addr->ssienr = 0x01;
+
+	spi_addr->dr[0] = val;
+	spi_addr->ser = 1;
+	while (((spi_addr->sr) & 0x05) != 0x04)
+		;
+
+	spi_addr->ser = 0x00;
+	spi_addr->ssienr = 0x00;
+}
+
+void lcd_write_data16(short val)
+{
+	lcd_write_data(val >> 8);
+	lcd_write_data(val & 0xff);
+}
+
+void st7789v_init_logo(void)
+{
+	int i, j;
+	int index, count;
+	unsigned int val;
+
+	gpio_pin_set_output(DC_PIN, GPIO_DM_OUTPUT);
+	gpio_pin_set_output(RESET_PIN, GPIO_DM_OUTPUT);
+	gpio_pin_set_value(DC_PIN, 1);
+	gpio_pin_set_value(RESET_PIN, 1);
+	mdelay(100);
+	/* lcd reset */
+	gpio_pin_set_value(RESET_PIN, 0);
+	mdelay(100);
+	gpio_pin_set_value(RESET_PIN, 1);
+	mdelay(100);
+
+	tft_spi_init();
+
+	index = -1;
+	val = init[++index];
+	count = sizeof(init) / sizeof(unsigned int);
+	while (index < count) {
+		if (val & FBTFT_OF_INIT_CMD) {
+			val &= 0xFFFF;
+			lcd_write_cmd(val);
+			val = init[++index];
+			while ((index < count) && !(val & 0xFFFF0000)) {
+				lcd_write_data(val);
+				val = init[++index];
+			}
+		} else if (val & FBTFT_OF_INIT_DELAY) {
+			mdelay(val & 0xFFFF);
+			val = init[++index];
+		} else {
+			printf("illegal init value 0x%X\n", val);
+			return;
+		}
+	}
+	/* clear screen */
+	lcd_write_cmd(0x2A);
+	lcd_write_data16(0);
+	lcd_write_data16(WIDTH - 1);
+	lcd_write_cmd(0x2B);
+	lcd_write_data16(0);
+	lcd_write_data16(HEIGHT - 1);
+	lcd_write_cmd(0x2C);
+
+	for (i = 0; i < WIDTH; i++) {
+		for (j = 0; j < HEIGHT; j++)
+			lcd_write_data16(0x0000);
+	}
+
+	/* draw logo */
+	lcd_write_cmd(0x2A);
+	lcd_write_data16(0); //x1
+	lcd_write_data16(239); //x2
+	lcd_write_cmd(0x2B);
+	lcd_write_data16(0); //y1
+	lcd_write_data16(239); //y2
+	lcd_write_cmd(0x2C);
+
+	for (i = 0; i < sizeof(gImage_avalon_logo);) {
+		lcd_write_data(gImage_avalon_logo[i]);
+		lcd_write_data(gImage_avalon_logo[i + 1]);
+		i += 2;
+	}
+	lcd_write_cmd(0x29); //display on
+}
diff --git a/board/canaan/k230_nano3s/st7789v.h b/board/canaan/k230_nano3s/st7789v.h
new file mode 100644
index 00000000..32a39bda
--- /dev/null
+++ b/board/canaan/k230_nano3s/st7789v.h
@@ -0,0 +1,240 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (c) 2026, Canaan Creative Co., Ltd.
+ */
+#ifndef _ST7789V_H_
+#define _ST7789V_H_
+#include <stdlib.h>
+#include <platform.h>
+#include <asm/asm.h>
+#include <asm/io.h>
+#include <asm/types.h>
+#include <linux/kernel.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <linux/delay.h>
+
+#define DW_SPI_TMOD_BIT10	0x0400
+#define DW_SPI_TMOD_BIT11	0x0800
+
+typedef enum {
+	SPI_FF_STANDARD = 0,
+	SPI_FF_DUAL,
+	SPI_FF_QUAD,
+	SPI_FF_OCTAL,
+} spi_frame_mode_e;
+
+/*----- SPI Control Codes: Mode Parameters: Frame Format -----*/
+typedef enum {
+	SPI_FORMAT_CPOL0_CPHA0 = 0, ///< Clock Polarity 0, Clock Phase 0
+	SPI_FORMAT_CPOL0_CPHA1, ///< Clock Polarity 0, Clock Phase 1
+	SPI_FORMAT_CPOL1_CPHA0, ///< Clock Polarity 1, Clock Phase 0
+	SPI_FORMAT_CPOL1_CPHA1, ///< Clock Polarity 1, Clock Phase 1
+} spi_work_mode_e;
+
+typedef struct _spi_ {
+	/* SPI Control Register 0                                    (0x00)*/
+	volatile unsigned int ctrlr0;
+	/* SPI Control Register 1                                    (0x04)*/
+	volatile unsigned int ctrlr1;
+	/* SPI Enable Register                                       (0x08)*/
+	volatile unsigned int ssienr;
+	/* SPI Microwire Control Register                            (0x0c)*/
+	volatile unsigned int mwcr;
+	/* SPI Slave Enable Register                                 (0x10)*/
+	volatile unsigned int ser;
+	/* SPI Baud Rate Select                                      (0x14)*/
+	volatile unsigned int baudr;
+	/* SPI Transmit FIFO Threshold Level                         (0x18)*/
+	volatile unsigned int txftlr;
+	/* SPI Receive FIFO Threshold Level                          (0x1c)*/
+	volatile unsigned int rxftlr;
+	/* SPI Transmit FIFO Level Register                          (0x20)*/
+	volatile unsigned int txflr;
+	/* SPI Receive FIFO Level Register                           (0x24)*/
+	volatile unsigned int rxflr;
+	/* SPI Status Register                                       (0x28)*/
+	volatile unsigned int sr;
+	/* SPI Interrupt Mask Register                               (0x2c)*/
+	volatile unsigned int imr;
+	/* SPI Interrupt Status Register                             (0x30)*/
+	volatile unsigned int isr;
+	/* SPI Raw Interrupt Status Register                         (0x34)*/
+	volatile unsigned int risr;
+	/* SPI Transmit FIFO Underflow Interrupt Clear Register      (0x38)*/
+	volatile unsigned int txeicr;
+	/* SPI Receive FIFO Overflow Interrupt Clear Register        (0x3c)*/
+	volatile unsigned int rxoicr;
+	/* SPI Receive FIFO Underflow Interrupt Clear Register       (0x40)*/
+	volatile unsigned int rxuicr;
+	/* SPI Multi-Master Interrupt Clear Register                 (0x44)*/
+	volatile unsigned int msticr;
+	/* SPI Interrupt Clear Register                              (0x48)*/
+	volatile unsigned int icr;
+	/* SPI DMA Control Register                                  (0x4c)*/
+	volatile unsigned int dmacr;
+#if SSIC_HAS_DMA == 1
+	/* SPI DMA Transmit Data Level                               (0x50)*/
+	volatile unsigned int dmatdlr;
+	/* SPI DMA Receive Data Level                                (0x54)*/
+	volatile unsigned int dmardlr;
+#elif SSIC_HAS_DMA == 2
+	/* SPI Destination Burst Length                              (0x50)*/
+	volatile unsigned int axiawlen;
+	/* SPI Source Burst Length                                   (0x54)*/
+	volatile unsigned int axiarlen;
+#else
+	unsigned int resv0[2];
+#endif
+	/* SPI Identification Register                               (0x58)*/
+	volatile const unsigned int idr;
+	/* SPI DWC_ssi component version                             (0x5c)*/
+	volatile unsigned int ssic_version_id;
+	/* SPI Data Register 0-36                                    (0x60 -- 0xec)*/
+	volatile unsigned int dr[36];
+	/* SPI RX Sample Delay Register                              (0xf0)*/
+	volatile unsigned int rx_sample_delay;
+	/* SPI SPI Control Register                                  (0xf4)*/
+	volatile unsigned int spi_ctrlr0;
+	/* SPI Transmit Drive Edge Register                          (0xf8)*/
+	volatile unsigned int ddr_drive_edge;
+	/* SPI XIP Mode bits                                         (0xfc)*/
+	volatile unsigned int xip_mode_bits;
+	/* SPI XIP INCR transfer opcode                              (0x100)*/
+	volatile unsigned int xip_incr_inst;
+	/* SPI XIP WRAP transfer opcode                              (0x104)*/
+	volatile unsigned int xip_wrap_inst;
+#if SSIC_CONCURRENT_XIP_EN
+	/* SPI XIP Control Register                                  (0x108)*/
+	volatile unsigned int xip_ctrl;
+	/* SPI XIP Slave Enable Register                             (0x10c)*/
+	volatile unsigned int xip_ser;
+	/* SPI XIP Receive FIFO Overflow Interrupt Clear Register    (0x110)*/
+	volatile unsigned int xrxoicr;
+	/* SPI XIP time out register for continuous transfers        (0x114)*/
+	volatile unsigned int xip_cnt_time_out;
+	/* not support dyn ws                                        (0x118)*/
+	unsigned int resv1[1];
+	/* SPI Transmit Error Interrupt Clear Register               (0x11c)*/
+	volatile unsigned int spitecr;
+#else
+	unsigned int resv1[6];
+#endif
+#if SSIC_HAS_DMA == 2
+	/* SPI Device Register                                       (0x120)*/
+	volatile unsigned int spidr;
+	/* SPI Device Address Register                               (0x124)*/
+	volatile unsigned int spiar;
+	/* AXI Address Register 0                                    (0x128)*/
+	volatile unsigned int axiar0;
+	/* AXI Address Register 1                                    (0x12c)*/
+	volatile unsigned int axiar1;
+	/* AXI Master Error Interrupt Clear Register                 (0x130)*/
+	volatile unsigned int axiecr;
+	/* Transfer Done Clear Interrupt Clear Register              (0x134)*/
+	volatile unsigned int donecr;
+#endif
+	/* resv                                                      (0x138 ~ 0x13c)*/
+	unsigned int resv3[2];
+#if SSIC_XIP_WRITE_REG_EN
+	/* XIP_WRITE_INCR_INST - XIP Write INCR transfer opcode      (0x140)*/
+	volatile unsigned int xip_write_incr_inst;
+	/* XIP_WRITE_WRAP_INST - XIP Write WRAP transfer opcode      (0x144)*/
+	volatile unsigned int xip_write_wrap_inst;
+	/* XIP_WRITE_CTRL - XIP Write Control Register               (0x148)*/
+	volatile unsigned int xip_write_ctrl;
+#else
+	unsigned int resv4[3];
+#endif
+} __attribute__((packed, aligned(4))) dw_spi_reg_t;
+
+typedef struct _gpio_bits {
+	unsigned int b0 : 1;
+	unsigned int b1 : 1;
+	unsigned int b2 : 1;
+	unsigned int b3 : 1;
+	unsigned int b4 : 1;
+	unsigned int b5 : 1;
+	unsigned int b6 : 1;
+	unsigned int b7 : 1;
+	unsigned int b8 : 1;
+	unsigned int b9 : 1;
+	unsigned int b10 : 1;
+	unsigned int b11 : 1;
+	unsigned int b12 : 1;
+	unsigned int b13 : 1;
+	unsigned int b14 : 1;
+	unsigned int b15 : 1;
+	unsigned int b16 : 1;
+	unsigned int b17 : 1;
+	unsigned int b18 : 1;
+	unsigned int b19 : 1;
+	unsigned int b20 : 1;
+	unsigned int b21 : 1;
+	unsigned int b22 : 1;
+	unsigned int b23 : 1;
+	unsigned int b24 : 1;
+	unsigned int b25 : 1;
+	unsigned int b26 : 1;
+	unsigned int b27 : 1;
+	unsigned int b28 : 1;
+	unsigned int b29 : 1;
+	unsigned int b30 : 1;
+	unsigned int b31 : 1;
+} __attribute__((packed, aligned(4))) gpio_bits_t;
+
+typedef union _gpio_access_tp {
+	/* 32x1 bit mode */
+	unsigned int u32[1];
+	/* 16x2 bit mode */
+	uint16_t u16[2];
+	/* 8x4 bit mode */
+	uint8_t u8[4];
+	/* 1 bit mode */
+	gpio_bits_t bits;
+} __attribute__((packed, aligned(4))) gpio_access_tp_t;
+
+typedef struct _gpio {
+	/* Offset 0x00: Data (output) registers */
+	gpio_access_tp_t data_output;
+	/* Offset 0x04: Data direction registers */
+	gpio_access_tp_t direction;
+	/* Offset 0x08: Data source registers */
+	gpio_access_tp_t source;
+	/* Offset 0x10 - 0x2f: Unused registers, 9x4 bytes */
+	unsigned int unused_0[9];
+	/* Offset 0x30: Interrupt enable/disable registers */
+	gpio_access_tp_t interrupt_enable;
+	/* Offset 0x34: Interrupt mask registers */
+	gpio_access_tp_t interrupt_mask;
+	/* Offset 0x38: Interrupt level registers */
+	gpio_access_tp_t interrupt_level;
+	/* Offset 0x3c: Interrupt polarity registers */
+	gpio_access_tp_t interrupt_polarity;
+	/* Offset 0x40: Interrupt status registers */
+	gpio_access_tp_t interrupt_status;
+	/* Offset 0x44: Raw interrupt status registers */
+	gpio_access_tp_t interrupt_status_raw;
+	/* Offset 0x48: Interrupt debounce registers */
+	gpio_access_tp_t interrupt_debounce;
+	/* Offset 0x4c: Registers for clearing interrupts */
+	gpio_access_tp_t interrupt_clear;
+	/* Offset 0x50: External port (data input) registers */
+	gpio_access_tp_t data_input;
+	/* Offset 0x54 - 0x5f: Unused registers, 3x4 bytes */
+	unsigned int unused_1[3];
+	/* Offset 0x60: Sync level registers */
+	gpio_access_tp_t sync_level;
+	/* Offset 0x64: ID code */
+	gpio_access_tp_t id_code;
+	/* Offset 0x68: Interrupt both edge type */
+	gpio_access_tp_t interrupt_bothedge;
+} __attribute__((packed, aligned(4))) gpio_t;
+
+typedef enum _gpio_drive_mode {
+	GPIO_DM_INPUT,
+	GPIO_DM_OUTPUT,
+} gpio_drive_mode_t;
+
+void st7789v_init_logo(void);
+#endif
