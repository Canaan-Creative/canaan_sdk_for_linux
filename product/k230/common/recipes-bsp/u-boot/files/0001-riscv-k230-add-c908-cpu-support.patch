diff --git a/arch/riscv/cpu/k230/cache.c b/arch/riscv/cpu/k230/cache.c
new file mode 100644
index 00000000..6faa7af2
--- /dev/null
+++ b/arch/riscv/cpu/k230/cache.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (c) 2026, Canaan Creative Co., Ltd.
+ */
+
+#include <cpu_func.h>
+#include <dm.h>
+#include <asm/cache.h>
+#include <dm/uclass-internal.h>
+#include <cache.h>
+#include <asm/csr.h>
+
+#ifndef __ASM
+#define __ASM __asm
+#endif
+
+#ifndef __ALWAYS_STATIC_INLINE
+#define __ALWAYS_STATIC_INLINE __attribute__((always_inline)) static inline
+#endif
+
+#ifndef __STATIC_INLINE
+#define __STATIC_INLINE static inline
+#endif
+
+#ifndef __ICACHE_PRESENT
+#define __ICACHE_PRESENT 1U
+#endif
+
+#ifndef __DCACHE_PRESENT
+#define __DCACHE_PRESENT 1U
+#endif
+
+/* CACHE Register Definitions */
+#define CACHE_MHCR_WBR_Pos	8U				/*!< CACHE MHCR: WBR Position */
+#define CACHE_MHCR_WBR_Msk	(0x1UL << CACHE_MHCR_WBR_Pos)	/*!< CACHE MHCR: WBR Mask */
+
+#define CACHE_MHCR_IBPE_Pos	7U				/*!< CACHE MHCR: IBPE Position */
+#define CACHE_MHCR_IBPE_Msk	(0x1UL << CACHE_MHCR_IBPE_Pos)	/*!< CACHE MHCR: IBPE Mask */
+
+#define CACHE_MHCR_L0BTB_Pos	6U				/*!< CACHE MHCR: L0BTB Position */
+#define CACHE_MHCR_L0BTB_Msk	(0x1UL << CACHE_MHCR_L0BTB_Pos)	/*!< CACHE MHCR: BTB Mask */
+
+#define CACHE_MHCR_BPE_Pos	5U				/*!< CACHE MHCR: BPE Position */
+#define CACHE_MHCR_BPE_Msk	(0x1UL << CACHE_MHCR_BPE_Pos)	/*!< CACHE MHCR: BPE Mask */
+
+#define CACHE_MHCR_RS_Pos	4U				/*!< CACHE MHCR: RS Position */
+#define CACHE_MHCR_RS_Msk	(0x1UL << CACHE_MHCR_RS_Pos)	/*!< CACHE MHCR: RS Mask */
+
+#define CACHE_MHCR_WB_Pos	3U				/*!< CACHE MHCR: WB Position */
+#define CACHE_MHCR_WB_Msk	(0x1UL << CACHE_MHCR_WB_Pos)	/*!< CACHE MHCR: WB Mask */
+
+#define CACHE_MHCR_WA_Pos	2U				/*!< CACHE MHCR: WA Position */
+#define CACHE_MHCR_WA_Msk	(0x1UL << CACHE_MHCR_WA_Pos)	/*!< CACHE MHCR: WA Mask */
+
+#define CACHE_MHCR_DE_Pos	1U				/*!< CACHE MHCR: DE Position */
+#define CACHE_MHCR_DE_Msk	(0x1UL << CACHE_MHCR_DE_Pos)	/*!< CACHE MHCR: DE Mask */
+
+#define CACHE_MHCR_IE_Pos	0U				/*!< CACHE MHCR: IE Position */
+#define CACHE_MHCR_IE_Msk	(0x1UL << CACHE_MHCR_IE_Pos)	/*!< CACHE MHCR: IE Mask */
+
+__ALWAYS_STATIC_INLINE uint64_t __get_MHCR(void)
+{
+	uint64_t result;
+
+	__ASM volatile("csrr %0, mhcr" : "=r"(result));
+	return result;
+}
+
+__ALWAYS_STATIC_INLINE void __set_MHCR(uint64_t mhcr)
+{
+	__ASM volatile("csrw mhcr, %0" : : "r"(mhcr));
+}
+
+/**
+ * \brief   Instruction Synchronization Barrier
+ * \details Instruction Synchronization Barrier flushes the pipeline in the processor,
+ *          so that all instructions following the ISB are fetched from cache or memory,
+ *          after the instruction has been completed.
+ */
+__ALWAYS_STATIC_INLINE void __ISB(void)
+{
+	/* fence.i; fence r, r */
+	asm volatile(".long 0x0000100f\n" ::: "memory");
+	asm volatile(".long 0x0220000f\n" ::: "memory");
+}
+
+/**
+ * \brief   Data Synchronization Barrier
+ * \details Acts as a special kind of Data Memory Barrier.
+ *          It completes when all explicit memory accesses before this instruction complete.
+ */
+__ALWAYS_STATIC_INLINE void __DSB(void)
+{
+	/* fence iorw, iorw */
+	asm volatile(".long 0x0ff0000f\n" ::: "memory");
+}
+
+__ALWAYS_STATIC_INLINE void __ICACHE_IALL(void)
+{
+	/* icache.iall */
+	asm volatile(".long 0x0100000b\n" ::: "memory");
+}
+
+__ALWAYS_STATIC_INLINE void __DCACHE_CIALL(void)
+{
+	/* dcache.ciall */
+	asm volatile(".long 0x0030000b\n" ::: "memory");
+}
+
+__STATIC_INLINE void csi_icache_enable(void)
+{
+#if (__ICACHE_PRESENT == 1U)
+	uint32_t cache;
+
+	__DSB();
+	__ISB();
+	__ICACHE_IALL();
+	cache = __get_MHCR();
+	cache |= CACHE_MHCR_IE_Msk;
+	__set_MHCR(cache);
+	__DSB();
+	__ISB();
+#endif
+}
+
+__STATIC_INLINE void csi_icache_disable(void)
+{
+#if (__ICACHE_PRESENT == 1U)
+	uint32_t cache;
+
+	__DSB();
+	__ISB();
+	cache = __get_MHCR();
+	cache &= ~CACHE_MHCR_IE_Msk;
+	__set_MHCR(cache);
+	__ICACHE_IALL();
+	__DSB();
+	__ISB();
+#endif
+}
+
+__STATIC_INLINE void csi_dcache_enable(void)
+{
+#if (__DCACHE_PRESENT == 1U)
+	uint32_t cache;
+
+	__DSB();
+	__ISB();
+	__DCACHE_CIALL();
+	cache = __get_MHCR();
+	cache |=
+		(CACHE_MHCR_DE_Msk | CACHE_MHCR_WB_Msk | CACHE_MHCR_WA_Msk |
+		 CACHE_MHCR_RS_Msk | CACHE_MHCR_BPE_Msk | CACHE_MHCR_L0BTB_Msk |
+		 CACHE_MHCR_IBPE_Msk | CACHE_MHCR_WBR_Msk);
+	__set_MHCR(cache);
+
+	__DSB();
+	__ISB();
+#endif
+}
+
+__STATIC_INLINE void csi_dcache_disable(void)
+{
+#if (__DCACHE_PRESENT == 1U)
+	register uint32_t cache;
+	__DSB();
+	__ISB();
+	cache = __get_MHCR();
+	cache &= ~(uint32_t)CACHE_MHCR_DE_Msk;
+	__set_MHCR(cache);
+	__DCACHE_CIALL();
+	__DSB();
+	__ISB();
+#endif
+}
+
+__STATIC_INLINE void csi_dcache_clean_invalid(void)
+{
+#if (__DCACHE_PRESENT == 1U)
+	__DSB();
+	__ISB();
+	__DCACHE_CIALL();
+	__DSB();
+	__ISB();
+#endif
+}
+
+void flush_dcache_all(void)
+{
+	csi_dcache_clean_invalid();
+}
+
+void flush_dcache_range(unsigned long start, unsigned long end)
+{
+	register unsigned long i asm("a0") = start &
+					     ~(CONFIG_SYS_CACHELINE_SIZE - 1);
+
+	for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+		asm volatile(".long 0x0295000b" :: "r"(i) : "memory"); /* dcache.cpa a0 */
+
+	asm volatile(".long 0x01b0000b"); /* T-HEAD sync.is */
+}
+
+void invalidate_dcache_range(unsigned long start, unsigned long end)
+{
+	register unsigned long i asm("a0") = start &
+					     ~(CONFIG_SYS_CACHELINE_SIZE - 1);
+
+	for (; i < end; i += CONFIG_SYS_CACHELINE_SIZE)
+		asm volatile(".long 0x02a5000b" :: "r"(i) : "memory"); /* dcache.ipa a0 */
+
+	asm volatile(".long 0x01b0000b"); /* T-HEAD sync.is */
+}
+
+void icache_enable(void)
+{
+#if !CONFIG_IS_ENABLED(SYS_ICACHE_OFF)
+	csi_icache_enable();
+#endif
+}
+
+void icache_disable(void)
+{
+#if !CONFIG_IS_ENABLED(SYS_ICACHE_OFF)
+	csi_icache_disable();
+#endif
+}
+
+void dcache_enable(void)
+{
+#if !CONFIG_IS_ENABLED(SYS_DCACHE_OFF)
+	csi_dcache_enable();
+#endif
+}
+
+void dcache_disable(void)
+{
+#if !CONFIG_IS_ENABLED(SYS_DCACHE_OFF)
+	csi_dcache_disable();
+#endif
+}
diff --git a/arch/riscv/cpu/k230/config.mk b/arch/riscv/cpu/k230/config.mk
new file mode 100644
index 00000000..d9eab166
--- /dev/null
+++ b/arch/riscv/cpu/k230/config.mk
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0+
+# Copyright (c) 2026, Canaan Creative Co., Ltd.
+
+ifndef CONFIG_SPL_BUILD
+	ifndef  CONFIG_TARGET_K230_FPGA
+		ifdef CONFIG_SPL
+			# Attach the BootROM header only when tools/firmware_gen.py
+			# exists; without it only the plain u-boot.bin and
+			# u-boot-spl.bin are built, not flash-bootable images.
+			ifneq ($(wildcard $(srctree)/tools/firmware_gen.py),)
+				INPUTS-y += add_firmware_head
+			endif
+		endif
+	endif
+endif
+add_firmware_head: u-boot.bin spl/u-boot-spl.bin u-boot.img
+	# wrap SPL with K230 BootROM header
+	cp spl/u-boot-spl.bin  t.bin ; python3 $(srctree)/tools/firmware_gen.py  -i t.bin -o u-boot-spl-k230.bin -n
+	$(srctree)/tools/endian-swap.py   u-boot-spl-k230.bin  u-boot-spl-k230-swap.bin
+	# file name used by the image packaging scripts
+	cp u-boot-spl-k230.bin fn_u-boot-spl.bin
+
+	# compress U-Boot, prepend U-Boot header and firmware header
+	gzip -k -f u-boot.bin ;
+	# Keep the standard CM byte 0x08: SPL decompresses with the software
+	# gunzip in lib/gunzip.c (unzip.o is built only into U-Boot proper),
+	# which takes under 1 s for U-Boot. The HW UGZIP marker 0x09 is set
+	# only on the kernel image (fw_payload.bin.gz, in gen-spinand.sh).
+	./tools/mkimage -A riscv -O u-boot -C gzip -T firmware -a ${CONFIG_TEXT_BASE} -e ${CONFIG_TEXT_BASE} -n uboot -d  u-boot.bin.gz   u-boot.img
+	cp u-boot.img t.bin;python3 $(srctree)/tools/firmware_gen.py  -i  t.bin -o fn_u-boot.img -n
+	# file name used by the image packaging scripts
+	cp fn_u-boot.img fn_ug_u-boot.bin
+
+	# SPI-NAND boot area raw image (5 MB, covers
+	# uboot_spl_a/uboot_spl_b/uboot_a/uboot_b)
+	# layout (as in genimage-spinand.cfg):
+	#  0x000000  uboot_spl_a  512K
+	#  0x080000  uboot_spl_b  512K  (redundant)
+	#  0x100000  uboot_a      2M
+	#  0x300000  uboot_b      2M    (redundant)
+	rm -f spinand.img
+	dd if=/dev/zero of=spinand.img bs=1M count=5 status=none
+	dd if=fn_u-boot-spl.bin of=spinand.img bs=512 seek=$$((0x000000/512)) conv=notrunc status=none
+	dd if=fn_u-boot-spl.bin of=spinand.img bs=512 seek=$$((0x080000/512)) conv=notrunc status=none
+	dd if=fn_ug_u-boot.bin  of=spinand.img bs=512 seek=$$((0x100000/512)) conv=notrunc status=none
+	dd if=fn_ug_u-boot.bin  of=spinand.img bs=512 seek=$$((0x300000/512)) conv=notrunc status=none
+	@echo "==> SPI-NAND boot image: spinand.img (flash to SPI-NAND offset 0)"
+	@echo "==> individual: fn_u-boot-spl.bin (0x0/0x80000) + fn_ug_u-boot.bin (0x100000/0x300000)"
diff --git a/arch/riscv/cpu/k230/ddr.sh b/arch/riscv/cpu/k230/ddr.sh
new file mode 100755
index 00000000..657daba8
--- /dev/null
+++ b/arch/riscv/cpu/k230/ddr.sh
@@ -0,0 +1,116 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0+
+# Copyright (c) 2026, Canaan Creative Co., Ltd.
+
+cat > ddr.awk  <<'EOF'
+#  data.c--data segment c-code array		inst.c----instruction c-code
+#  dmem.bin---data segment binary file;		imem.bin---instruction binary
+#  files.c---extract files and values, comparison file;
+
+BEGIN { print "wwwwwwwwwinstr---instruction--" > "files.c";}
+
+#instruction
+FNR >= isl && FNR <= iel &&  /reg_write/ && (! /^\s*\/\//) {
+	match($0, "[^+]*+ *(0x[0-f]*)[^,]*, *(0x[0-f]*)", ary);
+	print "//inst " $0 " " FNR " " ary[1] " " ary[2] >>"files.c";
+	instrction[ary[1]]=ary[2];
+}
+
+#data
+FNR >= dsl && FNR <=del  && /reg_write/ && (! /^\s*\/\//) {
+	match($0, "[^+]*+ *(0x[0-f]*)[^,]*, *(0x[0-f]*)", ary);
+	print "//data " $0 " "   FNR " " ary[1] " " ary[2] >>"files.c";
+	data[ary[1]]=ary[2];
+}
+
+END {
+	system("rm -rf it inst inst.c dt data data.c");
+	n=asorti(instrction, sorted)
+
+	for (i=1; i<=n; i++) {
+		if( (i>1) && ((strtonum(sorted[i])-strtonum(sorted[i-1])) !=1 )) {
+			printf ("instr 	error i=%d %s %s\n",i, sorted[i], sorted[i-1] );
+			exit 1;
+		}
+		printf ("%04x ",strtonum(instrction[sorted[i]]) ) >>"inst";
+		printf ("0x%04x,",strtonum(instrction[sorted[i]]) ) >>"inst.c";
+	}
+	system("xxd -r -p inst imem.bin");
+
+	n=asorti(data, sorted)
+	for (i=1; i<=n; i++) {
+		if( (i>1) && ((strtonum(sorted[i])-strtonum(sorted[i-1])) !=1 )) {
+			printf ("data error i=%d %s %s\n",i, sorted[i], sorted[i-1] );
+			exit 1;
+		}
+		printf ("%04x ",strtonum(data[sorted[i]]) )>>"data";
+		printf ("0x%04x,",strtonum(data[sorted[i]]) ) >>"data.c";
+	}
+	system("xxd -r -p data dmem.bin");
+}
+EOF
+
+f=$1
+df=$2
+isl_f=$3
+iel_f=$4
+dsl_f=$5
+del_f=$6
+
+#$3..$6: register offsets of the first and last reg_write() lines of the
+#instruction (isl, iel) and data (dsl, del) sections
+
+#get line numbers
+isl=$(grep $isl_f $f  -n | head -1 | cut  -d:  -f1);
+iel=$(grep $iel_f $f  -n | head -1 | cut  -d:  -f1);
+dsl=$(grep $dsl_f $f  -n | head -1 | cut  -d:  -f1);
+del=$(grep $del_f $f  -n | head -1 | cut  -d:  -f1);
+
+#convert to imem.bin dmem.bin
+set -e ; gawk -v isl=${isl}  -v iel=${iel} -v dsl=${dsl}  -v del=${del} -f ddr.awk  $f;
+cp $f $df;
+
+#replace with for-loop function;
+sed -i -e "${dsl},${del}d"  $df
+sed -i -e "${dsl}a ddr_wite_bin(DDR_REG_BASE+0x54000*4+0x02000000,gDdrD,ARRAY_SIZE(gDdrD));"  $df   ##data
+sed -i -e "${isl},${iel}d"  $df
+sed -i -e "${isl}a ddr_wite_bin(DDR_REG_BASE+0x50000*4+0x02000000,gDdrI,ARRAY_SIZE(gDdrI));"  $df  ##instruction
+
+cat > temp.c  <<EOF
+#include <asm/io.h>
+#include <linux/kernel.h>
+static const unsigned short gDdrI[]={
+	0x11111111,
+};
+static const unsigned short gDdrD[]={
+	0xdddddddd,
+};
+int  ddr_wite_bin(ulong regs,const unsigned short *bin,ulong blen)
+{
+	int i = 0;
+	for(i=0;i<blen;i++)
+	{
+		writel(*(bin+i), (volatile void __iomem *)(regs+i*4));
+	}
+
+	return 0;
+}
+EOF
+
+#instruction array
+tl=$(grep 0x11111111 temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  inst.c"  temp.c
+#data array
+tl=$(grep 0xdddddddd temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  data.c"  temp.c
+#update code and header file;
+sed -i -e "/0x98000000/ r temp.c"  $df
+
+rm -rf  dmem.c  imem.c  inst.c data.c   temp.c  data  inst
+
+#imem.bin--instruction bin file;
+#dmem.bin--data bin file;
+#files.c--- view the key values extracted earlier;
+rm -rf imem.bin  dmem.bin files.c  ddr.awk
diff --git a/arch/riscv/cpu/k230/ddr_2d.sh b/arch/riscv/cpu/k230/ddr_2d.sh
new file mode 100755
index 00000000..0faef550
--- /dev/null
+++ b/arch/riscv/cpu/k230/ddr_2d.sh
@@ -0,0 +1,151 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0+
+# Copyright (c) 2026, Canaan Creative Co., Ltd.
+
+#usage: ddr_2d.sh <in> <out> <isl> <iel> <dsl> <del> <2d del>
+cat > ddr.awk  <<'EOF'
+BEGIN { print "wwwwwwwwwinstr---instruction--" > "files.c";}
+
+#instruction
+FNR >= isl && FNR <= iel &&  /reg_write/ && (! /^\s*\/\//) {
+	match($0, "[^+]*+ *(0x[0-f]*)[^,]*, *(0x[0-f]*)", ary);
+	print "//inst " $0 " " FNR " " ary[1] " " ary[2] >>"files.c";
+	instrction[ary[1]]=ary[2];
+}
+
+#data
+FNR >= dsl && FNR <=del  && /reg_write/ && (! /^\s*\/\//) {
+	match($0, "[^+]*+ *(0x[0-f]*)[^,]*, *(0x[0-f]*)", ary);
+	print "//data " $0 " "   FNR " " ary[1] " " ary[2] >>"files.c";
+	data[ary[1]]=ary[2];
+}
+
+END {
+	system("rm -rf it inst inst.c dt data data.c");
+	n=asorti(instrction, sorted)
+
+	for (i=1; i<=n; i++) {
+		if( (i>1) && ((strtonum(sorted[i])-strtonum(sorted[i-1])) !=1 )) {
+			printf ("instr 	error i=%d %s %s\n",i, sorted[i], sorted[i-1] );
+			exit 1;
+		}
+		printf ("%04x ",strtonum(instrction[sorted[i]]) ) >>"inst";
+		printf ("0x%04x,",strtonum(instrction[sorted[i]]) ) >>"inst.c";
+	}
+	system("xxd -r -p inst imem.bin");
+
+	n=asorti(data, sorted)
+	for (i=1; i<=n; i++) {
+		if( (i>1) && ((strtonum(sorted[i])-strtonum(sorted[i-1])) !=1 )) {
+			printf ("data error i=%d %s %s\n",i, sorted[i], sorted[i-1] );
+			exit 1;
+		}
+		printf ("%04x ",strtonum(data[sorted[i]]) )>>"data";
+		printf ("0x%04x,",strtonum(data[sorted[i]]) ) >>"data.c";
+	}
+	system("xxd -r -p data dmem.bin");
+}
+EOF
+
+f=$1
+df=$2
+isl_f=$3
+iel_f=$4
+dsl_f=$5
+del_f=$6
+
+isl_f_2d=$3
+iel_f_2d=$4
+dsl_f_2d=$5
+del_f_2d=$7
+
+#$3..$6: register offsets of the first and last reg_write() lines of the
+#instruction (isl, iel) and data (dsl, del) sections; $7: register offset of
+#the last data line of the 2D training section
+
+#get line numbers
+isl=$(grep $isl_f $f  -n | head -1 | cut  -d:  -f1);
+iel=$(grep $iel_f $f  -n | head -1 | cut  -d:  -f1);
+dsl=$(grep $dsl_f $f  -n | head -1 | cut  -d:  -f1);
+del=$(grep $del_f $f  -n | head -1 | cut  -d:  -f1);
+
+isl_2d=$(grep $isl_f_2d $f  -n | tail -1 | cut  -d:  -f1);
+iel_2d=$(grep $iel_f_2d $f  -n | tail -1 | cut  -d:  -f1);
+dsl_2d=$(grep $dsl_f_2d $f  -n | tail -1 | cut  -d:  -f1);
+del_2d=$(grep $del_f_2d $f  -n | tail -1 | cut  -d:  -f1);
+
+#convert to imem.bin dmem.bin
+set -e ; gawk -v isl=${isl_2d}  -v iel=${iel_2d} -v dsl=${dsl_2d}  -v del=${del_2d} -f ddr.awk  $f;
+cp inst.c  inst_2d.c
+cp data.c data_2d.c
+cp files.c files_2d.c
+cp imem.bin imem_2d.bin
+cp dmem.bin dmem_2d.bin
+set -e ; gawk -v isl=${isl}  -v iel=${iel} -v dsl=${dsl}  -v del=${del} -f ddr.awk  $f;
+cp $f $df;
+
+#replace with for-loop function;
+sed -i -e "${dsl_2d},${del_2d}d"  $df
+sed -i -e "${dsl_2d}a ddr_wite_bin(DDR_REG_BASE+0x54000*4+0x02000000,gDdrD_2d,ARRAY_SIZE(gDdrD_2d));"  $df   ##data
+sed -i -e "${isl_2d},${iel_2d}d"  $df
+sed -i -e "${isl_2d}a ddr_wite_bin(DDR_REG_BASE+0x50000*4+0x02000000,gDdrI_2d,ARRAY_SIZE(gDdrI_2d));"  $df  ##instruction
+
+sed -i -e "${dsl},${del}d"  $df
+sed -i -e "${dsl}a ddr_wite_bin(DDR_REG_BASE+0x54000*4+0x02000000,gDdrD,ARRAY_SIZE(gDdrD));"  $df   ##data
+sed -i -e "${isl},${iel}d"  $df
+sed -i -e "${isl}a ddr_wite_bin(DDR_REG_BASE+0x50000*4+0x02000000,gDdrI,ARRAY_SIZE(gDdrI));"  $df  ##instruction
+
+cat > temp.c  <<EOF
+#include <asm/io.h>
+#include <linux/kernel.h>
+static const unsigned short gDdrI[]={
+	0x11111111,
+};
+static const unsigned short gDdrD[]={
+	0xdddddddd,
+};
+static const unsigned short gDdrI_2d[]={
+	0x12121212,
+};
+static const unsigned short gDdrD_2d[]={
+	0xd2d2d2d2,
+};
+int  ddr_wite_bin(ulong regs,const unsigned short *bin,ulong blen)
+{
+	int i = 0;
+	for(i=0;i<blen;i++)
+	{
+		writel(*(bin+i), (volatile void __iomem *)(regs+i*4));
+	}
+
+	return 0;
+}
+EOF
+
+#instruction array
+tl=$(grep 0x12121212 temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  inst_2d.c"  temp.c
+#data array
+tl=$(grep 0xd2d2d2d2 temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  data_2d.c"  temp.c
+
+#instruction array
+tl=$(grep 0x11111111 temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  inst.c"  temp.c
+#data array
+tl=$(grep 0xdddddddd temp.c  -n | cut  -d:  -f1);
+sed -i  -e "$tl d"   temp.c
+sed -i  -e "$(($tl-1)) r  data.c"  temp.c
+
+#update code and header file;
+sed -i -e "/0x98000000/ r temp.c"  $df
+
+rm -rf  dmem.c  imem.c  inst.c data.c   temp.c  data  inst
+
+#imem.bin--instruction bin file;
+#dmem.bin--data bin file;
+#files.c--- view the key values extracted earlier;
+rm -rf imem.bin  dmem.bin files.c  ddr.awk inst_2d.c  data_2d.c files_2d.c  imem_2d.bin dmem_2d.bin
