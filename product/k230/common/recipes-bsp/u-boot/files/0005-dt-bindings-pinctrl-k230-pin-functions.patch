 1 file changed, 98 insertions(+)
 create mode 100644 include/dt-bindings/pinctrl/k230_dt.h

diff --git a/include/dt-bindings/pinctrl/k230_dt.h b/include/dt-bindings/pinctrl/k230_dt.h
new file mode 100644
index 00000000..c7a77016
--- /dev/null
+++ b/include/dt-bindings/pinctrl/k230_dt.h
@@ -0,0 +1,98 @@
