# udhcpc event script for eth0, set with -s in /etc/network/interfaces. It runs
# the default script, then restarts chronyd on a new lease while the clock is
# still unset (before 2001), so time sync starts once the network is up.

/usr/share/udhcpc/default.script "$@"
rc=$?

if [ "$1" = "bound" ] && [ "$(date +%s)" -lt 1000000000 ]; then
    [ -x /etc/init.d/chronyd ] && /etc/init.d/chronyd restart >/dev/null 2>&1
fi

exit $rc
