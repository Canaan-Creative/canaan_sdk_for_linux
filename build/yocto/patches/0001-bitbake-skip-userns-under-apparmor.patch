From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: [PATCH] bitbake: utils: skip the network sandbox when AppArmor restricts user namespaces

Upstream-Status: Pending
---
 bitbake/lib/bb/utils.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/bitbake/lib/bb/utils.py b/bitbake/lib/bb/utils.py
index e6e21e2..9f19900 100644
--- a/bitbake/lib/bb/utils.py
+++ b/bitbake/lib/bb/utils.py
@@ -1662,6 +1662,21 @@ def disable_network(uid=None, gid=None):
     if gid is None:
         gid = os.getgid()
 
+    # AppArmor on Ubuntu 23.10+ restricts unprivileged user namespaces. When
+    # this is active, unshare(CLONE_NEWUSER) may succeed but writing uid_map
+    # fails with EPERM, leaving the process in a broken user namespace where
+    # exec of any subprocess returns EINVAL. Skip sandboxing entirely in that
+    # case rather than entering a partially-initialised namespace.
+    try:
+        with open("/proc/sys/kernel/"
+                  "apparmor_restrict_unprivileged_userns") as f:
+            if f.read().strip() == "1":
+                logger.debug("Skipping network sandbox: AppArmor restricts "
+                             "unprivileged user namespaces")
+                return
+    except OSError:
+        pass
+
     ret = libc.unshare(CLONE_NEWNET | CLONE_NEWUSER)
     if ret != 0:
         logger.debug("System doesn't support disabling network without admin privs")
-- 
2.43.0

